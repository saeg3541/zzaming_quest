<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quest_canvas"
    android:focusableInTouchMode="true"
    tools:context=".QuestBundleEditorActivity">

    <FrameLayout
        android:id="@+id/bundle_editor_toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/bundle_editor_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quest_back"
            android:scaleType="center"
            android:src="@drawable/quest_icon_back" />

        <TextView
            android:id="@+id/bundle_editor_heading"
            style="@style/QuestTextHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityHeading="true"
            android:text="@string/quest_bundle_edit_heading" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bundle_editor_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quest_bundle_rank_label" />

            <TextView
                android:id="@+id/bundle_editor_rank"
                style="@style/QuestTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/quest_bundle_badge"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/quest_ink"
                tools:text="@string/quest_rank_corporal" />

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/bundle_editor_name_input"
                android:text="@string/quest_bundle_name_label" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/bundle_editor_name_input"
                style="@style/QuestTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quest_editor_input_background"
                android:hint="@string/quest_bundle_name_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="56dp"
                android:nextFocusForward="@id/bundle_editor_description_input"
                android:padding="16dp"
                android:textColorHint="@color/quest_muted"
                tools:text="@string/quest_bundle_name" />

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/bundle_editor_description_input"
                android:text="@string/quest_bundle_description_label" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/bundle_editor_description_input"
                style="@style/QuestTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quest_editor_input_background"
                android:gravity="top|start"
                android:hint="@string/quest_bundle_description_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="76dp"
                android:padding="16dp"
                android:textColorHint="@color/quest_muted"
                tools:text="@string/quest_bundle_description" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bundle_editor_items"
                style="@style/QuestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/QuestTextHeading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/quest_bundle_items_label" />

                        <TextView
                            android:id="@+id/bundle_editor_item_count"
                            style="@style/QuestTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2개" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bundle_editor_empty"
                        style="@style/QuestTextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:minHeight="62dp"
                        android:text="@string/quest_bundle_empty"
                        tools:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/bundle_editor_quest_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_bundle_editor_quest" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bundle_editor_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/quest_editor_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/quest_brand"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bundle_editor_delete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/quest_bundle_delete_action"
                android:textAllCaps="false"
                android:textColor="@color/quest_danger"
                app:backgroundTint="@color/white"
                app:cornerRadius="16dp"
                app:strokeColor="@color/quest_danger" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
