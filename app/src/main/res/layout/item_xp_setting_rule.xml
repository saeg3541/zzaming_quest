<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/QuestXpRuleRow">

    <TextView
        android:id="@+id/rule_range"
        style="@style/QuestTextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        tools:text="@string/quest_xp_range_1" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/rule_input"
            style="@style/QuestXpRuleInput"
            android:saveEnabled="false"
            tools:text="100" />

        <TextView
            style="@style/QuestTextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:text="@string/quest_editor_xp_unit" />
    </FrameLayout>
</LinearLayout>
