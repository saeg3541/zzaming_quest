<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quest_canvas"
    tools:context=".QuestActivity">

    <FrameLayout
        android:id="@+id/quest_toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
<!--    프레임 뷰 그룹, 부모(constraintlayout)와 같은 시작, 끝, 위를 맞춰주고 width를 0으로 두어 길이를 맞춘다. -->


        <ImageButton
            android:id="@+id/quest_back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quest_back"
            android:scaleType="center"
            android:src="@drawable/quest_icon_back" />

        <TextView
            style="@style/QuestTextHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/quest_title" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quest_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/QuestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/quest_brand"
                app:cardCornerRadius="24dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/QuestTextSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quest_journey"
                                android:textColor="@color/quest_lime" />

                            <TextView
                                style="@style/QuestTextHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/quest_current_rank"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/QuestCard"
                            android:layout_width="48dp"
                            android:layout_height="38dp"
                            android:importantForAccessibility="noHideDescendants"
                            app:cardBackgroundColor="@color/quest_lime"
                            app:cardCornerRadius="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="24dp"
                                    android:layout_height="5dp"
                                    android:background="@color/quest_brand" />

                                <View
                                    android:layout_width="24dp"
                                    android:layout_height="5dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@color/quest_brand" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/quest_level"
                            style="@style/QuestText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:minHeight="42dp"
                            android:text="@string/quest_sample_level"
                            android:textColor="@color/quest_lime"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/quest_xp_settings"
                            style="@style/QuestTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quest_sample_xp"
                            android:textColor="@color/quest_lime" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/quest_xp_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no"
                        android:max="500"
                        android:progress="320"
                        app:indicatorColor="@color/quest_lime"
                        app:indicatorTrackGapSize="0dp"
                        app:trackColor="@color/quest_muted"
                        app:trackCornerRadius="4dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="7dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/QuestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/quest_line"
                app:cardCornerRadius="16dp"
                app:contentPadding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/QuestRankTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/quest_rank_private" />

                    <TextView
                        style="@style/QuestRankTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/quest_rank_tab_selected"
                        android:text="@string/quest_rank_first_class"
                        android:textColor="@color/quest_brand" />

                    <TextView
                        style="@style/QuestRankTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/quest_rank_corporal" />

                    <TextView
                        style="@style/QuestRankTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/quest_rank_sergeant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/QuestTextHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quest_rank_heading" />

                    <TextView
                        style="@style/QuestTextCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/quest_rank_description" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quest_rank_progress"
                    style="@style/QuestTextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/quest_brand"
                    tools:text="8 / 24 완료" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/QuestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1">

                            <TextView
                                style="@style/QuestTextCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/quest_bundle_badge"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="@string/quest_bundle_name"
                                android:textColor="@color/quest_gold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/quest_bundle_edit"
                            style="@style/QuestTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/quest_icon_edit"
                            android:drawablePadding="8dp"
                            android:minWidth="52dp"
                            android:text="@string/quest_edit" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/QuestTextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/quest_bundle_description" />

                        <TextView
                            android:id="@+id/quest_bundle_progress"
                            style="@style/QuestTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1 / 3" />
                    </LinearLayout>

                    <include
                        android:id="@+id/quest_locker_row"
                        layout="@layout/item_quest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/quest_laundry_row"
                        layout="@layout/item_quest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/quest_leave_row"
                        layout="@layout/item_quest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quest_bundle_add"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minHeight="48dp"
                android:text="@string/quest_add_bundle"
                android:textColor="@color/quest_brand"
                android:textSize="14sp"
                app:backgroundTint="@color/quest_soft"
                app:cornerRadius="16dp"
                app:icon="@drawable/quest_icon_plus"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                app:strokeColor="@color/quest_line"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
