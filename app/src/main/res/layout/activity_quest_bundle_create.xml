<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quest_canvas"
    android:focusableInTouchMode="true"
    tools:context=".QuestBundleCreateActivity">

    <FrameLayout
        android:id="@+id/bundle_create_toolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/bundle_create_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quest_back"
            android:scaleType="center"
            android:src="@drawable/quest_icon_back" />

        <TextView
            android:id="@+id/bundle_create_heading"
            style="@style/QuestTextHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityHeading="true"
            android:text="@string/quest_bundle_create_heading" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bundle_create_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quest_bundle_rank_label" />

            <TextView
                android:id="@+id/bundle_create_rank"
                style="@style/QuestTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/quest_bundle_badge"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/quest_ink"
                tools:text="@string/quest_rank_corporal" />

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/bundle_create_name_input"
                android:text="@string/quest_bundle_name_label" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/bundle_create_name_input"
                style="@style/QuestTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quest_editor_input_background"
                android:hint="@string/quest_bundle_name_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="56dp"
                android:nextFocusForward="@id/bundle_create_description_input"
                android:padding="16dp"
                android:textColorHint="@color/quest_muted" />

            <TextView
                style="@style/QuestTextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/bundle_create_description_input"
                android:text="@string/quest_bundle_description_label" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/bundle_create_description_input"
                style="@style/QuestTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quest_editor_input_background"
                android:gravity="top|start"
                android:hint="@string/quest_bundle_description_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="76dp"
                android:padding="16dp"
                android:textColorHint="@color/quest_muted" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bundle_create_preview"
                style="@style/QuestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/quest_soft"
                app:cardCornerRadius="24dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/QuestTextCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quest_editor_preview_label"
                        android:textColor="@color/quest_brand" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/quest_editor_input_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/bundle_create_preview_name"
                            style="@style/QuestTextBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/quest_bundle_preview_name"
                            tools:text="@string/quest_bundle_name" />

                        <TextView
                            android:id="@+id/bundle_create_preview_description"
                            style="@style/QuestTextCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            tools:text="@string/quest_bundle_description"
                            tools:visibility="visible" />

                        <TextView
                            style="@style/QuestTextCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/quest_bundle_empty" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bundle_create_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/quest_bundle_create_action"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/quest_brand"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
